# Mobile app environment variables
# Pass via --dart-define or build config

# API URL (Go backend)
# For Android emulator: 10.0.2.2 maps to host localhost
# For iOS simulator: localhost
# For physical device: your machine's IP or production URL
API_URL=http://10.0.2.2:3001

# PowerSync URL
POWERSYNC_URL=http://10.0.2.2:8080
